    <!-- Regras -->
    <string name="rules_title">How to play</string>
    <string name="rules_tonight">Tonight\'s rules</string>
    <string name="rules_tonight_freeze_on">A gift freezes after %1$d steals.</string>
    <string name="rules_tonight_freeze_off">No steal limit: any gift can always be stolen.</string>
    <string name="rules_tonight_steal_back_off">No stealing back a gift that was just stolen.</string>
    <string name="rules_tonight_steal_back_on">Stealing back right away is allowed.</string>
    <string name="rules_tonight_final_on">The first player gets a final swap.</string>
    <string name="rules_tonight_final_off">No final swap: the game ends with the last gift.</string>
    <string name="rules_bring_title">Before the party</string>
    <string name="rules_bring_body">Everyone brings one wrapped gift within the budget. Gag gifts are part of the fun. All gifts go in a pile in the middle.</string>
    <string name="rules_order_title">The order</string>
    <string name="rules_order_body">The app draws a random order. Going last is the best spot: by then every gift is on the table.</string>
    <string name="rules_turn_title">On your turn</string>
    <string name="rules_turn_body">Either open a wrapped gift from the pile, or steal a gift someone already opened. Your turn ends when you open a gift.</string>
    <string name="rules_stolen_title">When your gift is stolen</string>
    <string name="rules_stolen_body">You go again right away: open a new gift or steal a different one. The round keeps going until someone opens a gift from the pile.</string>
    <string name="rules_names_title">Dirty Santa, Yankee Swap…</string>
    <string name="rules_names_body">Same game, different names. Some groups also call it Grinch exchange, Thieving Secret Santa or Chinese gift exchange.</string>
